APP_NAME="DatingApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.datingapp.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dating_app_prod
DB_USERNAME=dating_user
DB_PASSWORD=secure_password_here

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dating_app_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@datingapp.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=
SESSION_SECURE_COOKIE=true

# Reverb / WebSockets
REVERB_APP_ID=dating-app-id
REVERB_APP_KEY=dating-app-key
REVERB_APP_SECRET=dating-app-secret
REVERB_HOST="api.datingapp.example.com"
REVERB_PORT=8080
REVERB_SCHEME=https

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=dating-app-firebase
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

# Google Play In-App Purchases
GOOGLE_PLAY_PACKAGE_NAME=com.datingapp.android
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/google-play-service-account.json

# App Limits and Pricing Defaults (Override in DB app_settings if needed)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
CALL_COIN_COST_PER_MINUTE=20
SUPER_LIKE_COIN_COST=10
BOOST_COIN_COST=50
BOOST_DURATION_MINUTES=30
